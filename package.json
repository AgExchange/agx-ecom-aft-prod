{
  "name": "agx-aft-vendure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env ENV_FILE=.env.development vendure dev all",
    "dev:server": "cross-env ENV_FILE=.env.development vendure dev server",
    "dev:worker": "cross-env ENV_FILE=.env.development vendure dev worker",
    "dev:dashboard": "cross-env ENV_FILE=.env.development vendure dev dashboard",
    "build": "cross-env ENV_FILE=.env.development vendure build all",
    "build:server": "cross-env ENV_FILE=.env.development vendure build server",
    "build:worker": "cross-env ENV_FILE=.env.development vendure build worker",
    "build:dashboard": "cross-env ENV_FILE=.env.development vendure build dashboard",
    "build:prod": "cross-env NODE_ENV=production ENV_FILE=.env.production vendure build all",
    "start:prod": "cross-env NODE_ENV=production vendure start all",
    "start:prod:server": "cross-env NODE_ENV=production node ./dist/index.js",
    "start:prod:worker": "cross-env NODE_ENV=production node ./dist/index-worker.js",
    "export:variants": "ts-node ./src/scripts/catalogue-exports/export-all-variants.ts",
    "export:low-stock": "ts-node ./src/scripts/catalogue-exports/export-low-stock-variants.ts",
    "check:pim": "ts-node ./src/scripts/connectivity-checks/pim-probe.ts"
  },
  "dependencies": {
    "@vendure/asset-server-plugin": "3.7.2",
    "@vendure/core": "3.7.2",
    "@vendure/dashboard": "3.7.2",
    "@vendure/email-plugin": "3.7.2",
    "@vendure/graphiql-plugin": "3.7.2",
    "axios": "^1.6.0",
    "dotenv": "17.4.2",
    "fast-xml-parser": "^4.5.7",
    "node-cache": "^5.1.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@vendure/cli": "3.7.2",
    "cross-env": "^7.0.3",
    "ts-node": "10.9.2",
    "typescript": "5.8.2",
    "vite": "7.3.6"
  }
}
