# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Values shown are the local-development defaults.

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=dev
VENDURE_SERVER_PORT=3000
COOKIE_SECRET=change-me

# ── Superadmin bootstrap ───────────────────────────────────────────────────
# Only used the first time the database is populated.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin

# ── Database ───────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Production points at the VM's Postgres 18.2.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agx_aft_dev
DB_USERNAME=vendure
DB_PASSWORD=vendure
DB_SCHEMA=public

# ── contact plugin ─────────────────────────────────────────────────────────
# Fallback recipient for contact form submissions. The channel's `infoEmail`
# custom field takes precedence when set.
CONTACT_ADMIN_EMAIL=devstack@agxchange.co.za

# ── quote-plugin ───────────────────────────────────────────────────────────
# Days a quote stays valid after being sent, and the reference prefix
# (references look like Q-2026-00042).
QUOTE_VALIDITY_DAYS=7
QUOTE_REFERENCE_PREFIX=Q

# ── cms plugin (Payload CMS) ───────────────────────────────────────────────
# Required in production. The plugin registers without them; outbound sync
# calls fail at runtime.
PAYLOAD_API_URL=
PAYLOAD_API_KEY=

# ── pim-sync plugin (AtroPIM) ──────────────────────────────────────────────
# The first three are required in production; the rest are optional tuning.
PIM_URL=
PIM_USER=
PIM_PASSWORD=
PIM_PART_TYPE_GROUP_CODE=
PIM_PAGE_SIZE=
PIM_FETCH_TIMEOUT_MS=
PIM_IMAGE_TIMEOUT_MS=
PIM_SYNC_STATUS_FILE=
PIM_SHOP_API_WARMUP_URL=
PIM_WARMUP_DELAY_MS=

# ── payfast-plugin ─────────────────────────────────────────────────────────
# Public URL of this server; used to build the PayFast ITN notify URL. In
# production this must be the real public hostname, reachable by PayFast.
# Per-PaymentMethod credentials (merchantId, merchantKey, passphrase, sandbox)
# are configured per PaymentMethod in the dashboard, not via env.
API_HOST=http://localhost:3000

# ── dsv-shipping-plugin ────────────────────────────────────────────────────
# REQUIRED — DsvShippingPlugin.init() runs validateOptions(), which throws on any
# missing value. The server will not start without all of these set. Local dev
# uses obvious placeholders; real values come from DSV.
DSV_CLIENT_EMAIL=
DSV_CLIENT_PASSWORD=
DSV_ACCESS_TOKEN_KEY=
DSV_API_BASE_URL=
DSV_TOKEN_ENDPOINT=
DSV_QUOTE_API_KEY=
DSV_BOOKING_API_KEY=
DSV_QUOTE_ENDPOINT=
DSV_BOOKING_ENDPOINT=
DSV_TEST_MDM=
# Booking defaults — business configuration rather than secrets.
DSV_DEFAULT_TRANSPORT_MODE=Road
DSV_DEFAULT_PACKAGE_TYPE=CTN
DSV_DEFAULT_STACKABLE=STACKABLE
DSV_DEFAULT_INCOTERMS_CODE=EXW
DSV_DEFAULT_INCOTERMS_LOCATION=
DSV_DEFAULT_PICKUP_START=08:00:00
DSV_DEFAULT_PICKUP_END=17:00:00
DSV_DEFAULT_PICKUP_DAYS_FROM_NOW=1
DSV_DEFAULT_DELIVERY_START=08:00:00
DSV_DEFAULT_DELIVERY_END=17:00:00
DSV_DEFAULT_DELIVERY_DAYS_FROM_NOW=3
DSV_INSURANCE_ENABLED=false
DSV_INSURANCE_CATEGORY=STD
DSV_INSURANCE_CURRENCY=ZAR
DSV_QUOTE_CACHE_TTL=300
DSV_DEBUG_MODE=false

# ── dsv-sadc-plugin ────────────────────────────────────────────────────────
# REQUIRED — DsvSadcPlugin.init() also throws on missing values.
# Username/password are optional: omit for the direct (no-auth) SOAP endpoint,
# set them for the DSV HCP API gateway (UAT/prod).
DSV_SADC_API_URL=
DSV_SADC_USERNAME=
DSV_SADC_PASSWORD=
DSV_SADC_CUSTOMER_NUMBER=
DSV_SADC_CUSTOMER_DEPT=
DSV_SADC_SHIPPER_PREFIX=
DSV_SADC_RELATION_NUMBER=
DSV_SADC_WAREHOUSE_SEARCH_NAME=
DSV_SADC_DEBUG=false

# ── dpo-plugin ─────────────────────────────────────────────────────────────
# REQUIRED — validateDpoPluginOptions() throws on a missing companyToken,
# serviceType, redirectUrl or backUrl, and useSandbox must be a real boolean.
# The server will not start without them.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_API_URL=https://secure.3gdirectpay.com/API/v6/
DPO_API_URL_V7=https://secure.3gdirectpay.com/API/v7/
DPO_REDIRECT_URL=
DPO_BACK_URL=
# {orderCode} and {status} are substituted at redirect time.
DPO_STOREFRONT_CONFIRMATION_URL=
# Anything other than the literal string "false" is treated as true.
DPO_USE_SANDBOX=true
